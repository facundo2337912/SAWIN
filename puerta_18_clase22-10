function expenseSplitter(expenses) {
  let totalGastado = expenses.reduce((acc, persona) => acc + persona.spent, 0);
  console.log("Total gastado: ", totalGastado);

  let cantidadPersonas = expenses.length;
  let gastoxPersona = totalGastado / cantidadPersonas;
  console.log("Cada uno debe pagar: ", gastoxPersona);
  console.log("-----");
  console.log("¿Quien pago demas o de menos?");

  for (let number of expenses) {
    for (let key in number) {
      console.log(key, ":", number[key]);
      if (number.spent - gastoxPersona > 0) {
        console.log("Pago de mas:$", number.spent - gastoxPersona);
        break;
      } else if (number.spent - gastoxPersona < 0) {
        console.log("Pago de menos:$", gastoxPersona - number.spent);
        break;
      } else {
        console.log("Pago justo");
        break;
      }
    }
  }
  return [gastoxPersona, cantidadPersonas];
}
